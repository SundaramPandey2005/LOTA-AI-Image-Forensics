# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Research papers (the compiled course report under report/ is tracked)
*.pdf
!report/*.pdf

# PyTorch checkpoints & artifacts
*.pt
*.pth
*.bin
*.ckpt
checkpoints/
runs/
wandb/

# Datasets (root level only, preserve src/data/)
/data/
/datasets/
!src/data/
*.zip
*.tar
*.tar.gz
*.h5

# SQLite & Logs
*.db
*.sqlite
*.sqlite3
*.log
logs/

# Jupyter & IDEs
.ipynb_checkpoints
.vscode/
.idea/
*.swp

# Experiment outputs (curated copies live in results/)
outputs/
outputs_quick/
.notebook/
.pytest_cache/

# ...but the curated copy of the reported run is tracked (weights excluded)
!results/**
results/**/*.pth
